# Variables para correr `claude` local (Parte 2 del proyecto).
# La instructora te pasa los valores. Copiá este archivo a `.env` y completalo.
# Antes de abrir claude:   set -a; source .env; set +a
# `.env` está en .gitignore — NO lo commitees.

TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_BOARD_ID=

CONFLUENCE_URL=https://<org>.atlassian.net/wiki
CONFLUENCE_USERNAME=
CONFLUENCE_TOKEN=

SLACK_BOT_TOKEN=
SLACK_TEAM_ID=
SLACK_CHANNEL_IDS=
